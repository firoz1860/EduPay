

# Runtime
NODE_ENV=development
PORT=8080


DATABASE_URL=postgresql://postgres:password@localhost:5432/edupay?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Open self-registration (/auth/register). Demo convenience — set to false in
# production and create staff accounts via an admin instead.
ALLOW_OPEN_REGISTRATION=true

# Stripe (test mode). Do NOT commit real values.
# STRIPE_SECRET_KEY: your sk_test_... (enables creating PaymentIntents).
# STRIPE_WEBHOOK_SECRET: the signing secret used to verify webhook signatures.
#   - Local CLI test: the whsec_... printed by `stripe listen`.
#   - Production: the signing secret of your Stripe Dashboard webhook endpoint.
#   - Multiple signers: comma-separate them, e.g. whsec_aaa,whsec_bbb
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payments
STRIPE_CANCEL_URL=http://localhost:3000/payments


AI_PROVIDER=mock

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
