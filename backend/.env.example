# ─────────────────────────────────────────────────────────────
# EduPay Backend — environment variables
# Copy to .env and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=8080

# Database — Supabase Postgres connection string (Settings → Database → Connection string → URI).
# Use the pooled "Transaction" connection string for serverless/Render, appended with ?pgbouncer=true&connection_limit=1
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/edupay?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/payments
STRIPE_CANCEL_URL=http://localhost:3000/payments

# AI — provider is "mock" (default, no key required) or "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
