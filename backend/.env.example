

# Runtime
NODE_ENV=development
PORT=8080


DATABASE_URL=postgresql://postgres:password@localhost:5432/edupay?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/payments
STRIPE_CANCEL_URL=http://localhost:3000/payments


AI_PROVIDER=mock

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
