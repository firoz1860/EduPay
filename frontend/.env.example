# EduPay Frontend — public environment variables (safe to expose to the browser).
# Copy to .env.local for development.

# Base URL of the backend API (include the /api/v1 path, no trailing slash).
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Production example (Render):
# NEXT_PUBLIC_API_URL=https://edupay-api.onrender.com/api/v1

NEXT_PUBLIC_APP_NAME=EduPay

# Stripe publishable key (pk_test_... / pk_live_...). Safe to expose to the browser.
# Required for the Student card-payment flow when the backend has Stripe enabled;
# must belong to the same Stripe account as the backend's STRIPE_SECRET_KEY.
# Leave unset when running with the simulated gateway (no backend Stripe key).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Show the seeded demo login credentials on the login/settings screens.
# Leave unset (or false) in production; set true only for demos.
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false
