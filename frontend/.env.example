# EduPay Frontend — public environment variables (safe to expose to the browser).
# Copy to .env.local for development.

# Base URL of the backend API (include the /api/v1 path, no trailing slash).
# Development:
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Production example (Render):
# NEXT_PUBLIC_API_URL=https://edupay-api.onrender.com/api/v1

NEXT_PUBLIC_APP_NAME=EduPay
